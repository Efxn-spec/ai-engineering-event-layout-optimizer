        <mxCell id="e10" value="Passed&lt;br&gt;layout +&lt;br&gt;results" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#1a2b4c;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=12;fontColor=#1a2b4c;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="checker" target="output">
          <mxGeometry relative="1" as="geometry" />
